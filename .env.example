# Copy to .env; use absolute paths. WSL: use Linux paths (/home/..., /mnt/c/...).
# make detects UID/GID automatically. For direct docker compose, set id -u / id -g here.
HOST_UID=1000
HOST_GID=1000
# Parent containing <paper-name>/Makefile, main.tex, .latexmkrc.
PAPERS_DIR=/absolute/path/to/papers
BIB_DIR=/absolute/path/to/bib
# Fonts stay on the host. In main.tex use Path=/usr/share/fonts/ms-fonts/.
FONTS_DIR=/absolute/path/to/fonts
